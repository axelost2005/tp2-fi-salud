# Conexión a PostgreSQL (local con `docker compose up -d db`, o Neon/Supabase en la nube)
DATABASE_URL=postgresql://salud:salud@127.0.0.1:5432/tp2_salud

# Clave para firmar los JWT de sesión de Payload (usar un valor largo y aleatorio)
PAYLOAD_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO

# URL pública del sitio, sin barra final (CORS, links y SEO)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secreto para ejecutar tareas programadas (jobs)
CRON_SECRET=CAMBIAR_POR_OTRO_SECRETO

# Secreto para validar las vistas previas de borradores
PREVIEW_SECRET=CAMBIAR_POR_OTRO_SECRETO
